<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <Version>1.0.0</Version>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <!-- dotnet publish (publish.cmd): one folder, no runtime to install on the VM (Windows Server 2019 x64):
       VipShop.exe + appsettings.json + wwwroot + Start.cmd. Plain builds / tests stay framework-dependent. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- the site serves wwwroot from next to the exe (AppContext.BaseDirectory), also for dotnet run and the tests -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- ExcludeFromSingleFile: PublishSingleFile would otherwise bundle it inside VipShop.exe -->
    <None Update="Start.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VipShop.Tests" />
  </ItemGroup>

</Project>
